# Conexão pública Firebase (mesmo projeto da identidade Tera ID)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Conta de serviço Firestore: configure apenas no ambiente do servidor
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# SSO central TeraApps; cliente já previsto com callback /volut/entrar
TERA_ID_BASE_URL=https://teraaps.vercel.app
TERA_VOLUT_CLIENT_ID=tera_velysoma_volut_web
# Para outro domínio, cadastre o callback exato também no Tera ID.
